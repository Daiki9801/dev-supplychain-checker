# Keep GitHub-generated source archives suitable for non-technical users.
# The source repository keeps synthetic fixtures for maintainer validation, but
# end-user archives should not ship files that intentionally trigger findings.
reports/** export-ignore
other/** export-ignore
token.txt export-ignore
*.token export-ignore
.env export-ignore
.env.* export-ignore
*.pem export-ignore
*.key export-ignore
*.pfx export-ignore
*.p12 export-ignore
id_rsa* export-ignore
id_ed25519* export-ignore
credentials.json export-ignore
auth.json export-ignore
.npmrc export-ignore
.pypirc export-ignore
tests/samples/** export-ignore
tests/samples/manifest.json -export-ignore
tests/samples/README.md -export-ignore

# Preserve bytes-sha256 fixtures exactly, including on autocrlf Windows checkouts.
tests/samples/npm-cache-static-metadata/AppData/Local/npm-cache/_cacache/content-v2/sha512/aa/blob -text
tests/samples/npm-cache-blob/.npm-cache/_cacache/content-v2/sha512/aa/bb/cache-blob -text
tests/samples/vscode-extension-bad/.vscode/extensions/nrwl.angular-console-18.95.0/native.node -text
